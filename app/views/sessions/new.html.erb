
<h1>Login page</h1>
<%= form_with url: new_session_path, method: :get do |form| %>
  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :password, autocomplete: "new-password"  %><br>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>
  <p>
    <%= f.submit 'Login' %>
  </p>
<% end %>

<%= link_to "Sign up", new_user_path %>