
<h1>Login page</h1>
<%= form_with url: session_path do %>
  <div>
    <%= label_tag :email %><br>
    <%= email_field_tag :email %>
  </div>
  <div>
    <%= label_tag :password %><br>
    <%= password_field_tag :password, autocomplete: "current-password" %>
  </div>
  <p>
    <%= submit_tag 'Login' %>
  </p>
<% end %>

<%= link_to "Sign up", new_user_path %>